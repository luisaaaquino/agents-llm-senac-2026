# Provedor compatível com a API da OpenAI (Mistral, ou Ollama local).
# NUNCA comitar o .env real — só este exemplo, sem valores.
OPENAI_API_KEY=
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODELO=mistral-small-latest

# Alternativa sem chave, rodando local (instale o Ollama e faça
# `ollama pull llama3.2` antes): comente as 3 linhas acima e descomente as
# 3 abaixo.
# OPENAI_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODELO=llama3.2
