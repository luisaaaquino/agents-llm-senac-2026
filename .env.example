# Copie para .env e preencha. NUNCA comite o .env real.
# Provedor compatível com a API da OpenAI. Nesta entrega: Gemini, plano
# gratuito do Google AI Studio (chave em https://aistudio.google.com/apikey).
#   LLM_BASE_URL         = https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODELO           = gemini-3.5-flash-lite
#   LLM_MODELO_EMBEDDING = gemini-embedding-001
# Alternativas (docs/modelos.md): Mistral (https://api.mistral.ai/v1,
# mistral-small-latest) ou Ollama local (http://localhost:11434/v1, chave
# "ollama") — o Ollama não tem o modelo de embedding acima; o RAG precisa de
# um provedor de embedding.
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_MODELO=

# Opcionais
# LLM_MODELO_AVALIADOR — outro modelo para o avaliador (plano B, docs/case.md §2.11)
# LLM_MIN_INTERVALO_S  — segundos entre chamadas; o padrão (4) respeita o limite
#                        por minuto do plano gratuito
LLM_MODELO_AVALIADOR=
LLM_MODELO_EMBEDDING=
LLM_MIN_INTERVALO_S=
